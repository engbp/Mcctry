# MCC MNU — Stage B environment template.
# Copy to `.env.local` for local dev. `.env.local` is gitignored; never commit real values.
# Never prefix a secret with NEXT_PUBLIC_ — anything NEXT_PUBLIC_* is baked into the
# browser bundle and is public by definition.
#
# Supabase's current API key formats:
#   - Publishable key: `sb_publishable_...` (public, browser-safe)
#   - Secret key:      `sb_secret_...`      (server-only, NEVER NEXT_PUBLIC_*)
# The legacy JWT-style keys (`eyJ...`) are also still accepted.

# --- Public, safe to expose to the browser (publishable key) ---
# Project URL: https://<project-ref>.supabase.co (Settings -> Data API / Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# --- Server-only. NEVER expose to the browser. ---
# Secret key (legacy name: service_role). Used by server actions and admin-only
# paths. Must stay out of NEXT_PUBLIC_* and out of Git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# --- Optional: enable integration/RLS tests that need a live instance. ---
# When unset, `npm run test` runs local-only tests and skips the RLS suite.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key
# SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
